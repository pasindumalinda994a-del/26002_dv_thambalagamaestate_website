NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# MongoDB
# Prefer a standard mongodb:// seed-list URI on Windows if mongodb+srv://
# fails with: querySrv ECONNREFUSED _mongodb._tcp...
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=thambalagama_estate

# Owner dashboard auth
ADMIN_PASSWORD=
AUTH_SECRET=

# Booking emails (Resend)
RESEND_API_KEY=
EMAIL_FROM=Thambalagama Estate <bookings@yourdomain.com>
OWNER_EMAIL=info@thambalagamaestate.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
